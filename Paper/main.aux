\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Low-dimensional CRM predicts combinatorial gut assembly with complexity-invariant fidelity.} \textbf  {a}, Out-of-sample fit on 73 held-out consortia across dynamic timepoints ($t \in [12, 60]$\,h; $K=3$, $S=12$; test $R^2 = 0.766$, Pearson $r = 0.877$, $N = 4,380$), colored by timepoint. Dashed line: identity. \textbf  {b}, Trajectory prediction accuracy ($r$) versus initial Shannon diversity ($H$), showing no complexity-dependent decay ($r = -0.125,\ p = 0.292$). Line and band: linear fit with 95\% confidence interval; points colored by species richness ($S$). \textbf  {c}, Trajectory accuracy versus mean Bray-Curtis dissimilarity to training consortia ($r = +0.036,\ p = 0.765$), demonstrating compositional generalization.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:ophelia_assembly}{{1}{3}{\textbf {Low-dimensional CRM predicts combinatorial gut assembly with complexity-invariant fidelity.} \textbf {a}, Out-of-sample fit on 73 held-out consortia across dynamic timepoints ($t \in [12, 60]$\,h; $K=3$, $S=12$; test $R^2 = 0.766$, Pearson $r = 0.877$, $N = 4,380$), colored by timepoint. Dashed line: identity. \textbf {b}, Trajectory prediction accuracy ($r$) versus initial Shannon diversity ($H$), showing no complexity-dependent decay ($r = -0.125,\ p = 0.292$). Line and band: linear fit with 95\% confidence interval; points colored by species richness ($S$). \textbf {c}, Trajectory accuracy versus mean Bray-Curtis dissimilarity to training consortia ($r = +0.036,\ p = 0.765$), demonstrating compositional generalization}{figure.1}{}}
