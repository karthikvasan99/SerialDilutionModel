\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Metacommunity CRM enables zero-shot transfer across physical microenvironments.} Models were trained on liquid (No Carrier) and mucosal (Mucin Agar) regimes, and evaluated zero-shot on inert Plain Agar across 6 serial dilution cycles ($K=4$). \textbf  {a}, Zero-shot parity on supernatant broth ($R^2 = +0.289$, Pearson $r = 0.624$), colored by passage ($P_1 \to P_6$). \textbf  {b}, Zero-shot parity on carrier biofilm ($R^2 = +0.442$, $r = 0.669$; Combined $R^2 = 0.386$, $r = 0.631$), outperforming the static inoculum null ($R^2 = -0.219$). \textbf  {c}, Accuracy across passages $P_1 \to P_6$; after initial transient adjustment ($P_1 \to P_2$), equilibrium accuracy ($P_3 \to P_6$, yellow) stabilizes at $R^2 > 0.45$ ($r \approx 0.75$). Dotted line: inoculum null. \textbf  {d}, Dynamic trajectories of representative colonizers comparing observed relative abundances (solid lines, filled circles) with zero-shot forecasts (dashed lines, open squares).}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:pollard_plain_agar}{{2}{8}{\textbf {Metacommunity CRM enables zero-shot transfer across physical microenvironments.} Models were trained on liquid (No Carrier) and mucosal (Mucin Agar) regimes, and evaluated zero-shot on inert Plain Agar across 6 serial dilution cycles ($K=4$). \textbf {a}, Zero-shot parity on supernatant broth ($R^2 = +0.289$, Pearson $r = 0.624$), colored by passage ($P_1 \to P_6$). \textbf {b}, Zero-shot parity on carrier biofilm ($R^2 = +0.442$, $r = 0.669$; Combined $R^2 = 0.386$, $r = 0.631$), outperforming the static inoculum null ($R^2 = -0.219$). \textbf {c}, Accuracy across passages $P_1 \to P_6$; after initial transient adjustment ($P_1 \to P_2$), equilibrium accuracy ($P_3 \to P_6$, yellow) stabilizes at $R^2 > 0.45$ ($r \approx 0.75$). Dotted line: inoculum null. \textbf {d}, Dynamic trajectories of representative colonizers comparing observed relative abundances (solid lines, filled circles) with zero-shot forecasts (dashed lines, open squares)}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Latent chemical axes and competitive pressure predict intervention divergence.} \textbf  {a}, Cross-host transfer: predicted versus observed terminal passage ($T_6$) abundance of \textit  {Methanomicrobium sp.} (log scale) across 5-bar conditions in Cow OSU and Cow BRRS, evaluated using the model trained solely on Cow OSU. In wet-lab validation, +TMA at 5 bar rescued methanogen colonization in Cow BRRS (23.0\% observed). \textbf  {b}, Localized competitive pressure ($z$-score) on \textit  {Methanomicrobium sp.} by resident competitors, revealing an insurmountable barrier in Cow OSU ($C_i$: 5.80 to 7.40) versus competitive release in Cow BRRS. \textbf  {c}, Barycentric niche allocation simplex ($\Delta ^2$) representing relative metabolic budget allocation across basal syngas ($\mathbf  {u}_{\text  {H}_2:\text  {CO}_2}$), Methanol ($\mathbf  {v}_{\text  {MeOH}}$), and Trimethylamine ($\mathbf  {v}_{\text  {TMA}}$) using non-negative min-offset affinities ($\tilde  {\theta } \ge 0$), highlighting the strong methylotrophic trade-off ($r = -0.69$, $p < 10^{-12}$).}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:german_competition}{{3}{9}{\textbf {Latent chemical axes and competitive pressure predict intervention divergence.} \textbf {a}, Cross-host transfer: predicted versus observed terminal passage ($T_6$) abundance of \textit {Methanomicrobium sp.} (log scale) across 5-bar conditions in Cow OSU and Cow BRRS, evaluated using the model trained solely on Cow OSU. In wet-lab validation, +TMA at 5 bar rescued methanogen colonization in Cow BRRS (23.0\% observed). \textbf {b}, Localized competitive pressure ($z$-score) on \textit {Methanomicrobium sp.} by resident competitors, revealing an insurmountable barrier in Cow OSU ($C_i$: 5.80 to 7.40) versus competitive release in Cow BRRS. \textbf {c}, Barycentric niche allocation simplex ($\Delta ^2$) representing relative metabolic budget allocation across basal syngas ($\mathbf {u}_{\text {H}_2:\text {CO}_2}$), Methanol ($\mathbf {v}_{\text {MeOH}}$), and Trimethylamine ($\mathbf {v}_{\text {TMA}}$) using non-negative min-offset affinities ($\tilde {\theta } \ge 0$), highlighting the strong methylotrophic trade-off ($r = -0.69$, $p < 10^{-12}$)}{figure.3}{}}
