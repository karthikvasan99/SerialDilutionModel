\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {A unified coupled-biofilm CRM with universal metabolic parameters simultaneously captures assembly across distinct physical regimes.} Parity plots of observed versus predicted strain abundances across 6 serial dilution cycles (18 days, 50 strains) for (A) No Carrier ($R^2 = 0.755$), (B) Plain Agar ($R^2 = 0.873$), (C) Mucin Agar ($R^2 = 0.857$), and (D) Global Combined fit across all conditions ($R^2 = 0.834$, Pearson $r = 0.914$, $\text  {MAE} = 0.0071$). All three regimes are parameterized by a single, universal metabolic consumption matrix $\mathbf  {\Theta }$ ($K=3$) and byproduct matrix $W$, demonstrating that environmental partitioning can be modeled purely through biophysical transport kinetics.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:pollard_simultaneous}{{2}{4}{\textbf {A unified coupled-biofilm CRM with universal metabolic parameters simultaneously captures assembly across distinct physical regimes.} Parity plots of observed versus predicted strain abundances across 6 serial dilution cycles (18 days, 50 strains) for (A) No Carrier ($R^2 = 0.755$), (B) Plain Agar ($R^2 = 0.873$), (C) Mucin Agar ($R^2 = 0.857$), and (D) Global Combined fit across all conditions ($R^2 = 0.834$, Pearson $r = 0.914$, $\text {MAE} = 0.0071$). All three regimes are parameterized by a single, universal metabolic consumption matrix $\mathbf {\Theta }$ ($K=3$) and byproduct matrix $W$, demonstrating that environmental partitioning can be modeled purely through biophysical transport kinetics}{figure.2}{}}
